{
  "version": 6,
  "configurePresets": [
    {
      "name": "python",
      "generator": "Ninja",
      "description": "MLIR Python bindings with the CPython 3.12+ stable ABI",
      "binaryDir": "${sourceDir}/../build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/../build/install",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER_EXTERNAL_TOOLCHAIN": "/usr",
        "CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN": "/usr",
        "CMAKE_C_FLAGS": "--no-default-config",
        "CMAKE_CXX_FLAGS": "--no-default-config",
        "CMAKE_LINKER_TYPE": "MOLD",
        "CMAKE_INSTALL_RPATH_USE_LINK_PATH": true,
        "CMAKE_C_VISIBILITY_PRESET": "default",
        "CMAKE_CXX_VISIBILITY_PRESET": "default",
        "CMAKE_VISIBILITY_INLINES_HIDDEN": true,
        "LLVM_ENABLE_ASSERTIONS": true,
        "LLVM_LINK_LLVM_DYLIB": true,
        "MLIR_LINK_MLIR_DYLIB": true,
        "LLVM_ENABLE_WARNINGS": true,
        "LLVM_ENABLE_BINDINGS": false,
        "LLVM_ENABLE_ZSTD": false,
        "LLVM_ENABLE_ZLIB": false,
        "LLVM_ENABLE_LIBXML2": false,
        "LLVM_ENABLE_LIBEDIT": false,
        "LLVM_INCLUDE_DOCS": false,
        "LLVM_INCLUDE_EXAMPLES": false,
        "LLVM_INCLUDE_TESTS": false,
        "LLVM_INCLUDE_TOOLS": true,
        "LLVM_INCLUDE_UTILS": false,
        "LLVM_INCLUDE_RUNTIMES": false,
        "LLVM_INCLUDE_BENCHMARKS": false,
        "LLVM_APPEND_VC_REV": false,
        "LLVM_TARGETS_TO_BUILD": "Native;NVPTX;AMDGPU;RISCV",
        "LLVM_ENABLE_PROJECTS": "mlir",
        "MLIR_INCLUDE_TESTS": false,
        "MLIR_ENABLE_BINDINGS_PYTHON": true,
        "MLIR_ENABLE_PYTHON_STABLE_ABI": true,
        "MLIR_ENABLE_EXECUTION_ENGINE": true,
        "Python3_EXECUTABLE": "${sourceDir}/../../.venv/bin/python",
        "Python_EXECUTABLE": "${sourceDir}/../../.venv/bin/python"
      }
    },
    {
      "name": "python-lld",
      "inherits": "python",
      "description": "MLIR Python bindings linked with LLD",
      "cacheVariables": {
        "CMAKE_LINKER_TYPE": "LLD"
      }
    }
  ]
}
